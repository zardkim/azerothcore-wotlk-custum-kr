# 빌드 산출물 (build.bat 로 다시 생성됨)
build/
dist/
*.spec

# 다운로드/설치 중 임시로 생기는 파일 (개발 중 테스트로 생길 수 있음)
_client_download.exe
_client_download.exe.part
client/

# 실행 중 생기는 로컬 상태(사용자가 고른 실제 설치 경로) - PC마다 다르므로 커밋 안 함
install_state.json

# 숨겨진 관리자 모드(Ctrl+Shift + ⚙)의 DB 접속 정보 - 운영자 본인 PC에만 있어야
# 하고, 절대 빌드/배포에 포함되면 안 됨
admin_config.json

# 관리자 모드 "백업/복원"에서 DB로부터 내려받는 실제 플레이어 계정/캐릭터 백업
# 파일 - 운영자 본인 PC에만 있어야 함
backups/

# 백업/복원 로직을 짤 때 참고한 Windows 리팩용 마이그레이션 도구 원본 - 순수 참고
# 자료라 커밋도, 빌드(PyInstaller)에도 포함되면 안 됨
참조소스/

# Python
__pycache__/
*.pyc
