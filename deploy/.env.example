# .env.example -> 복사해서 .env로 저장
# cp .env.example .env

# 모든 실제 데이터(설정/맵/DB/로그)가 저장될 기준 경로.
# 원하는 볼륨/디스크로 자유롭게 바꾸세요. 이 아래에 configs/, data/, mysql/, logs/ 폴더가 생깁니다.
# 배포 환경에 맞는 줄 하나만 남기고 나머지는 주석 처리(#) 하세요.

# Synology NAS (Container Manager) 기본값 — /volume1을 다른 볼륨 번호로 바꿔도 됨 (예: /volume4/...)
BASE_DATA_DIR=/volume1/docker/azerothcore

# Ubuntu 등 일반 리눅스 서버라면 위 줄을 주석 처리하고 아래 줄 사용
# BASE_DATA_DIR=/opt/azerothcore

# 이 이미지들을 실제로 구운 자신의 레지스트리 주소+프로젝트 경로 (예: harbor.example.com/azerothcore).
# 값을 안 넣으면 docker compose가 명확한 에러로 바로 알려줍니다.
DOCKER_REGISTRY=changeme

# data.zip(Cameras/maps/mmaps/vmaps/기본 dbc) 다운로드 주소 — 클라이언트 추출
# 바이너리라 이 저장소/이미지에는 포함하지 않음. 나스 Web Station 등 정적 파일
# 서버에 직접 올려두고 curl로 바로 받아지는 주소를 넣으세요(File Station "공유" 링크는
# 브라우저 전용 HTML 페이지를 줄 수 있어 권장하지 않음 — 올리기 전에 반드시
# `curl -fL -o test.zip "<주소>"`로 실제 zip이 받아지는지 확인). 파일명에 공백이 있으면
# URL 인코딩(%20) 필요. 최초 설치 시 한 번만 자동으로 받아서 풀고, 이미 데이터가
# 있으면(수동으로 넣어둔 경우 포함) 다시 받지 않습니다.
# 예: KR_DATA_URL=https://dl.example.com/wow_data/data.zip
# ${BASE_DATA_DIR}/data 에 직접 복사할 계획이면 비워둬도 됩니다(그 경우에만 사용).
KR_DATA_URL=
KR_DATA_SHA256=

# "DBC 3.3.5a 12340.zip"(한글 DBC) 다운로드 주소 — data.zip을 푼 뒤에 그 위에 덮어써서
# 기본(영문) dbc를 한글판으로 교체합니다. 비워두면 기본 dbc만 설치됩니다.
# 예: KR_DBC_URL=https://dl.example.com/wow_data/DBC%203.3.5a%2012340.zip
KR_DBC_URL=
KR_DBC_SHA256=

# ac-database-kr 이미지 자체의 MySQL root 초기화용 비밀번호 (앱은 acore/acore 계정을 씀)
DOCKER_DB_ROOT_PASSWORD=changeme

# 포트가 이미 사용 중이면 아래 값을 바꾸세요 (기본값: WoW 표준 포트)
# DOCKER_AUTH_EXTERNAL_PORT=3724
# DOCKER_WORLD_EXTERNAL_PORT=8085
# DOCKER_SOAP_EXTERNAL_PORT=7878

# NAS에 다른 MySQL/MariaDB가 이미 3306을 쓰고 있으면 다른 포트로 변경
DOCKER_DB_EXTERNAL_PORT=3307

# 웹 포털(ac-web) 접속 포트. 이미 11220번을 다른 서비스가 쓰고 있으면 변경
# DOCKER_WEB_EXTERNAL_PORT=11220

# 웹 포털(ac-web) 필수 비밀값 — DB/렐름 등 나머지 값은 docker-compose.yml에 이미
# 고정되어 있어(worldserver/authserver와 동일 방식) 여기 넣을 필요 없습니다.
# SOAP 서비스 계정("websoap")은 이 비밀번호로 ac-web이 최초 기동 시 자동 생성됩니다.
WEB_SOAP_PASSWORD=changeme
# 관리자 페이지(/admin) 로그인 정보
# WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=changeme
# 생성 방법: openssl rand -hex 32
WEB_ADMIN_SESSION_SECRET=changeme
